# Copy to .env.local and fill in from your Supabase project (Settings, then API).
#
# Public values only. Next inlines every NEXT_PUBLIC_ variable into the client
# bundle, so nothing secret may live here. The anon key is designed to be
# public and every table it reaches is protected by row level security.
#
# These are the same two values the mobile app uses under an EXPO_PUBLIC_
# prefix. Both apps must point at the same project or an administrator will be
# verifying a different database from the one practitioners submit to.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where this console is deployed. Certificates carry a QR code pointing at
# {this}/verify/{BAIN}. Once certificates with QR codes have been issued the
# path shape must not change, or every printed code breaks.
NEXT_PUBLIC_VERIFICATION_URL=http://localhost:3000
