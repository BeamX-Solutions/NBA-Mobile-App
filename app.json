{
  "expo": {
    "name": "NBA Legal Fees",
    "slug": "nba-legal-fees",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/nba-logo.png",
    "scheme": "nbalegalfees",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "org.nbaanaocha.legalfees"
    },
    "android": {
      "package": "org.nbaanaocha.legalfees",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/nba-logo.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/nba-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/nba-logo.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8F7"
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos so you can attach a payment receipt to a transaction."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
