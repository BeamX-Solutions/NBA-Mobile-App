# Copy to .env and fill in from your Supabase project (Settings, then API).
#
# Public values only. Expo inlines every EXPO_PUBLIC_ variable into the app
# bundle, and a shipped bundle should be treated as published. The anon key is
# designed to be public and every table it can reach is protected by row level
# security.
#
# The database password and the service role key must never appear in this
# file. They live in the repository root .env, which is used only for running
# migrations from a trusted machine.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
