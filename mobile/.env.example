# Copy to .env and fill in from your Supabase project (Settings, then API).
#
# Public values only. Expo inlines every EXPO_PUBLIC_ variable into the app
# bundle, and a shipped bundle should be treated as published. The anon key is
# designed to be public and every table it can reach is protected by row level
# security.
#
# The database password and the service role key must never appear in this
# file. They live in the repository root .env, which is used only for running
# migrations from a trusted machine.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where web/ is deployed. Every certificate carries a QR code encoding
# {this}/verify/{BAIN}, so this is the address a land registry will open.
#
# Two things follow from that. It is inlined at bundle time, not read at
# runtime, so a running Metro must be restarted after changing it and a store
# build has it baked in. And once certificates carrying QR codes have been
# issued, neither this host nor the /verify/{BAIN} path shape may change: a
# certificate already sitting in someone's file has to keep resolving.
#
# Currently a vercel.app subdomain, which is fine while certificates are test
# ones. Move it to a domain you control before issuing anything real.
EXPO_PUBLIC_VERIFICATION_URL=https://nba-mobile-app.vercel.app
